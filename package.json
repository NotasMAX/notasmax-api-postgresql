{
  "name": "notasmax-api-postgresql",
  "version": "1.0.0",
  "private": true,
  "description": "Local and CI foundation for the Notas Max API.",
  "main": "dist/functions/*.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "func start",
    "test": "node --require ./test/load-local-settings.cjs --test ./test/health.test.cjs ./test/postgres.integration.test.cjs",
    "test:integration": "node ./test/run-integration-tests.cjs",
    "db:migrate:latest": "knex migrate:latest --knexfile knexfile.cjs --env development",
    "db:migrate:status": "knex migrate:list --knexfile knexfile.cjs --env development",
    "db:migrate:rollback": "knex migrate:rollback --knexfile knexfile.cjs --env development"
  },
  "dependencies": {
    "@azure/functions": "4.16.5",
    "knex": "3.3.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "6.0.3"
  }
}
